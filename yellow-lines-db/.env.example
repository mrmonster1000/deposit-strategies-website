# UK Yellow Lines Database - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================================================
# Environment
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# Database - PostgreSQL with PostGIS
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yellow_lines_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ============================================================================
# D-TRO API - Register at:
# https://www.gov.uk/guidance/digital-traffic-regulation-orders-d-tro-service
# ============================================================================
DTRO_API_KEY=your_api_key_here
DTRO_ENVIRONMENT=production
# Use "integration" for testing

# ============================================================================
# ETL Pipeline
# ============================================================================
ETL_BATCH_SIZE=100
ETL_MAX_CONCURRENT=5
ETL_FULL_SYNC_DAYS=7
ETL_INCREMENTAL_HOURS=6

# ============================================================================
# API Server
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_CORS_ORIGINS=*
API_RATE_LIMIT=60
# API_KEY=optional_api_key_for_write_operations
